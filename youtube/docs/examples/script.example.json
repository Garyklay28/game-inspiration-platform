[
  {"id": "c01", "text": "브레인롯, 왜 맨날 내 것만 털릴까요?", "say": "브레인롯, 왜 맨날 내 것만 털릴까요?", "shot": "shot_01"},
  {"id": "c02", "text": "제 기지를 한번 볼게요.", "say": "제 기지를 한번 볼게요.", "pause": 0.3, "shot": "shot_02"},
  {"id": "c03", "text": "털린 이유는 딱 2가지였어요.", "say": "털린 이유는 딱 두 가지였어요.", "shot": "shot_02"},
  {"id": "c04", "text": "첫째, 문이 하나뿐이에요.", "say": "첫째, 문이 하나뿐이에요.", "shot": "shot_02"},
  {"id": "c05", "text": "들어오면 바로 보물 앞이죠.", "say": "들어오면 바로 보물 앞이죠.", "shot": "shot_02"},
  {"id": "c06", "text": "둘째, 비싼 걸 입구에 뒀어요.", "say": "둘째, 비싼 걸 입구에 뒀어요.", "shot": "shot_02"},
  {"id": "c07", "text": "훔치기 제일 좋은 자리예요.", "say": "훔치기 제일 좋은 자리예요.", "shot": "shot_02"},
  {"id": "c08", "text": "그래서 배치를 바꿔 봤어요.", "say": "그래서 배치를 바꿔 봤어요.", "pause": 0.4, "shot": "shot_03"},
  {"id": "c09", "text": "1단계, 입구를 2개로 나눠요.", "say": "일 단계, 입구를 두 개로 나눠요.", "shot": "shot_03"},
  {"id": "c10", "text": "하나는 막다른 길이에요.", "say": "하나는 막다른 길이에요.", "shot": "shot_03"},
  {"id": "c11", "text": "2단계, 비싼 건 맨 안쪽에.", "say": "이 단계, 비싼 건 맨 안쪽에.", "shot": "shot_03"},
  {"id": "c12", "text": "싼 건 앞쪽에 미끼로 둬요.", "say": "싼 건 앞쪽에 미끼로 둬요.", "shot": "shot_03"},
  {"id": "c13", "text": "3단계, 잠금은 나갈 때마다.", "say": "삼 단계, 잠금은 나갈 때마다.", "shot": "shot_03"},
  {"id": "c14", "text": "이게 제일 자주 까먹어요.", "say": "이게 제일 자주 까먹어요.", "shot": "shot_03"},
  {"id": "c15", "text": "실제로 도둑이 들어오면?", "say": "실제로 도둑이 들어오면?", "pause": 0.4, "shot": "shot_04"},
  {"id": "c16", "text": "막다른 길로 먼저 가요.", "say": "막다른 길로 먼저 가요.", "shot": "shot_04"},
  {"id": "c17", "text": "그사이에 잠금이 돌아와요.", "say": "그사이에 잠금이 돌아와요.", "shot": "shot_04"},
  {"id": "c18", "text": "결국 빈손으로 나가요.", "say": "결국 빈손으로 나가요.", "shot": "shot_04"},
