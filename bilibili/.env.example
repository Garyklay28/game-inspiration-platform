# 복사해서 .env 로 저장한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
ANTHROPIC_API_KEY=

# 선택: 모델·동작 조정
# BILI_AGENT_MODEL=claude-sonnet-5-5
# BILI_AGENT_FALLBACK=1        # 거절(refusal) 시 서버 측 대체 모델 사용
# BILI_OFFLINE=0               # 1 이면 네트워크 없이 data/snapshots 만 사용
# BILI_POPULAR_PAGES=5
# BILI_REQUEST_INTERVAL=1.0

# 선택: Supabase (둘 다 있으면 별칭 사전을 Supabase 에서 읽음)
# SUPABASE_URL=
# SUPABASE_KEY=
