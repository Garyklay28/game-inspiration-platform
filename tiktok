from langchain_core.tools import tool

@tool
def search_tiktok_gamedev(keyword: str, engine: str = "all") -> str:
    """TikTok에서 게임 제작(게임 개발) 관련 튜토리얼 영상을 키워드와 게임 엔진(Unity, Godot, Unreal, all)으로 검색하여 영상 ID, 제목, 크리에이터, 조회수, 해시태그 목록을 반환합니다."""
    mock_videos = [
        {"video_id": "tt_101", "title": "Unity 2D 플랫포머 점프 구현 60초 컷", "creator": "@unity_dev_kr", "engine": "Unity", "views": 452000, "likes": 38900, "tags": ["#unity", "#게임개발", "#인디게임", "#코딩"]},
        {"video_id": "tt_102", "title": "Godot 4 입문자가 3일 만에 첫 뱀서라이크 만든 과정", "creator": "@godot_maker", "engine": "Godot", "views": 890000, "likes": 91200, "tags": ["#godot", "#gamedev", "#게임제작", "#1인개발"]},
        {"video_id": "tt_103", "title": "Aseprite로 도트(픽셀) 캐릭터 걷기 애니메이션 그리기", "creator": "@pixel_art_lab", "engine": "Art/Pixel", "views": 310000, "likes": 27500, "tags": ["#픽셀아트", "#게임그래픽", "#aseprite", "#게임제작"]},
        {"video_id": "tt_104", "title": "Unity C# 초보자가 가장 많이 하는 오브젝트 풀링 실수", "creator": "@code_architect", "engine": "Unity", "views": 195000, "likes": 15400, "tags": ["#unity", "#csharp", "#게임프로그래밍"]},
        {"video_id": "tt_105", "title": "Godot GDScript로 타격감(화면 흔들림 + 히트스톱) 넣는 법", "creator": "@juicy_gamedev", "engine": "Godot", "views": 620000, "likes": 64000, "tags": ["#godot", "#게임기획", "#타격감", "#인디게임"]},
    ]
    results = [
        v for v in mock_videos
        if (engine.lower() == "all" or engine.lower() in v["engine"].lower())
        and (keyword.lower() in v["title"].lower() or any(keyword.lower() in t.lower() for t in v["tags"]) or keyword in ["게임", "제작", "개발", "튜토리얼"])
    ]
    return str(results if results else mock_videos[:3])

@tool
def get_tiktok_video_details(video_id: str) -> str:
    """특정 TikTok 영상의 ID(video_id)를 입력받아 핵심 튜토리얼 요약, 난이도(입문/초급/중급), 사용 툴, 댓글 반응 및 웹페이지 임베드용 URL을 반환합니다."""
    details_db = {
        "tt_101": {"video_id": "tt_101", "difficulty": "입문", "duration": "58초", "summary": "Rigidbody2D와 AddForce, 바닥 체크(OverlapCircle)를 활용한 2D 점프 물리 구현 핵심 코드 설명", "embed_url": "https://www.tiktok.com/@unity_dev_kr/video/101"},
        "tt_102": {"video_id": "tt_102", "difficulty": "입문", "duration": "1분 30초", "summary": "Godot 4의 노드 시스템과 시그널(Signal)을 활용해 3일 만에 자동 공격 생존 게임을 완성하는 개발 일지", "embed_url": "https://www.tiktok.com/@godot_maker/video/102"},
        "tt_103": {"video_id": "tt_103", "difficulty": "초급", "duration": "45초", "summary": "16x16 캔버스에서 4프레임 걷기 사이클을 자연스럽게 표현하는 픽셀 아트 팁", "embed_url": "https://www.tiktok.com/@pixel_art_lab/video/103"},
        "tt_104": {"video_id": "tt_104", "difficulty": "중급", "duration": "1분 15초", "summary": "총알 생성 시 Instantiate/Destroy 반복 대신 ObjectPool을 사용해 프레임 드랍을 방지하는 방법", "embed_url": "https://www.tiktok.com/@code_architect/video/104"},
        "tt_105": {"video_id": "tt_105", "difficulty": "초급", "duration": "52초", "summary": "Camera2D 오프셋 흔들림과 Engine.time_scale 조절로 액션 게임의 타격감을 극대화하는 기법", "embed_url": "https://www.tiktok.com/@juicy_gamedev/video/105"},
    }
    return str(details_db.get(video_id, {"error": "해당 video_id를 찾을 수 없습니다."}))

