# 이 파일을 .env 로 복사한 뒤 값을 직접 입력하세요. 키를 채팅에 붙여 넣지 않습니다.

# YouTube Data API v3 키 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
YOUTUBE_API_KEY=

# 썸네일 이미지 생성 (config/pipeline.json 의 thumbnail.provider 가 openai 일 때만 사용, 호출마다 과금)
OPENAI_API_KEY=

# Supabase (db push 에만 사용). 서비스 롤 키는 서버에서만 쓰고 브라우저 코드에 넣지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
